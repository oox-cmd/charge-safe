<view wx:if="{{a}}" class="page data-v-4d95b12a"><view class="card data-v-4d95b12a"><text class="card-title data-v-4d95b12a">提交报修</text><view class="field data-v-4d95b12a"><text class="lbl data-v-4d95b12a">设备/端口</text><input placeholder="请输入设备或端口编号" placeholder-style="color:#c0c4cc" class="input data-v-4d95b12a" value="{{b}}" bindinput="{{c}}"/></view><view class="field data-v-4d95b12a"><text class="lbl data-v-4d95b12a">故障类型</text><view class="tag-row data-v-4d95b12a"><text wx:for="{{d}}" wx:for-item="t" wx:key="b" class="{{['data-v-4d95b12a', 'tag', t.c]}}" bindtap="{{t.d}}">{{t.a}}</text></view></view><view class="field data-v-4d95b12a"><text class="lbl data-v-4d95b12a">问题描述（至少10个字）</text><block wx:if="{{r0}}"><textarea placeholder="请详细描述故障情况" placeholder-style="color:#c0c4cc" class="textarea data-v-4d95b12a" maxlength="{{500}}" value="{{e}}" bindinput="{{f}}"/></block><text class="count data-v-4d95b12a">{{g}}/500</text></view><view class="field data-v-4d95b12a"><text class="lbl data-v-4d95b12a">现场照片（最多3张）</text><view class="photo-grid data-v-4d95b12a"><view wx:for="{{h}}" wx:for-item="img" wx:key="c" class="photo-item data-v-4d95b12a"><image src="{{img.a}}" class="photo-thumb data-v-4d95b12a" mode="aspectFill"/><view class="photo-del data-v-4d95b12a" bindtap="{{img.b}}">✕</view></view><view wx:if="{{i}}" class="photo-add data-v-4d95b12a" bindtap="{{k}}"><text class="add-icon data-v-4d95b12a">+</text><text class="add-text data-v-4d95b12a">{{j}}</text></view></view></view></view><button loading="{{l}}" disabled="{{m}}" class="btn-submit data-v-4d95b12a" bindtap="{{n}}">提交报修</button></view><view wx:else class="success-page data-v-4d95b12a"><view class="success-card data-v-4d95b12a"><text class="check data-v-4d95b12a">✅</text><text class="stitle data-v-4d95b12a">提交成功</text><text class="sno data-v-4d95b12a">工单号：{{o}}</text><text class="stip data-v-4d95b12a">维修人员将尽快处理，请耐心等待</text><button class="btn-back data-v-4d95b12a" bindtap="{{p}}">查看报修记录</button></view></view>